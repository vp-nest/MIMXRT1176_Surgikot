    preset AutoSize = true;
    preset Bitmap = Res::PassPlainImg;
  }

  $rect <939,229,1139,269>
  slot SlotOnClick
  {
    if(sender == NumButton10)
    {
        Number = "";              
    }
    else
    {
        var Widget::NumButton currentBT = (Widget::NumButton)sender;
        if(Number.length >= 4)
            Number = "";
        Number = Number + currentBT.label.String;
        trace(Number);
    }
  }

  $rect <939,299,1139,339>
  property string Number;

  $rect <939,339,1139,379>
  onset Number
  {
    // The value doesn't change - nothing to do.
    if ( pure Number == value )
      return;

    // Remember the property's new value.
    pure Number = value;

    UpdatePinImg(Number.length);
  }

  $rect <939,399,1139,439>
  method void UpdatePinImg( arg int32 pinLength )
  {
    var int8 i = 0;
    var int8 maxPin = 4;
    for(; i < pinLength; i++)
    {
        (PinImgArray[i]).Bitmap = Res::PassFilledImg;
    }
    for(; i < maxPin; i++)
    {
        PinImgArray[i].Bitmap = Res::PassPlainImg;
    }
  }

  $rect <939,439,1139,479>
  array Views::Image PinImgArray[ 4 ] =
  (
    Default[0] = ImgPin1;
    Default[1] = ImgPin2;
    Default[2] = ImgPin3;
    Default[3] = ImgPin4;
  );

  $rect <939,179,1139,219>
  slot SlotOnEnter
  {
    postsignal OnEnterKey;
  }

  $rect <650,140,850,180>
  property slot OnEnterKey;
}

