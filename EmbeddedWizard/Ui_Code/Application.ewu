    this.Timer.Enabled = false;
  }

  $rect <-100,904,100,940>
  slot slotRelease
  {
    this.rctComplete.Color =  #FF6B5DFF;
    Application::GlobalSettings.SurgerCompletedTime = this.Text1.String;
    trace "---------------" ,this.Text1.String;
    trace "---------------" ,Application::GlobalSettings.SurgerCompletedTime;
    if ( Owner != null )
    {
      Owner.SwitchToDialog(new Application::ProfileSurgeryCompletedScreen,null, null, null, null, null, null, null, null, null,false);
    }

  }

