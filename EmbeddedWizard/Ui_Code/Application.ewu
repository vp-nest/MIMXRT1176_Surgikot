$rect <198,120,398,160>
$output false
class LogInScreen : Core::Group
{
  $rect <-260,430,-60,470>
  inherited method Init()
  {
    trace "INIT ______________HI";
    // TO DO: Write your code here ... 
  }

  $rect <1320,10,1520,50>
  inherited property Bounds = <0,0,1280,720>;

  $rect <20,20,160,60>
  object Application::TitleBar TitleBar
  {
    preset Bounds = <0,0,1280,64>;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,64,1280,720>;
    preset Color = #141A2BFF;
  }

  $rect <20,20,160,60>
  object Views::Line TopLine
  {
    preset Point2 = <1280,64>;
    preset Point1 = <0,64>;
    preset Color = #555D6DFF;
  }

  $rect <20,20,160,60>
  object Widget::NumPad NumPad
  {
    preset Bounds = <386,270,894,754>;
    preset OnEnterKey = SlotOnEnter;
  }

  $rect <20,20,160,60>
  object Views::Image LockIcon
  {
    preset Bounds = <568,82,707,180>;
    preset Bitmap = Res::LockIconImg;
  }

  $rect <20,20,160,60>
  object Views::Text H1
  {
    preset Bounds = <533,182,742,219>;
    preset AutoSize = true;
    preset WrapText = false;
    preset String = "System Login";
    preset Font = Application::FontBold32;
  }

  $rect <20,20,160,60>
  object Views::Text H2
  {
    preset Bounds = <462,223,816,255>;
    preset AutoSize = true;
    preset WrapText = false;
    preset String = "Enter Admin PIN to continue";
    preset Font = Application::FontNormal28;
  }

  $rect <1339,70,1539,110>
  slot SlotOnEnter
  {
    if ( this.NumPad.Number == "" )
      return;

    var string pin =  this.NumPad.Number;



    //Application::Navigation.CheckLogin( pin );

    //this.NumPad.Number = "";
    this.NumPad.Enabled = false;




    if(this.NumPad.Number == "1234")
    {
        trace"Go to Next Screen.................";
        this.NumPad.Number = "";
        if (Owner != null)
        {
            Owner.SwitchToDialog(new Application::ProfileScreen, null, null, null, null, null, null, null, null, null, false);
        }
        //this.SwitchToDialog( new Application::ProfileScreen, null, null, null, null, null, null, null, null, null, false );
        //this.PresentDialog( new Application::ProfileScreen, null, null, null, null, null, null, null, null, false );
    }
    else
    {
        this.NumPad.Number = "";
    } 
  }

  $rect <1530,270,1730,310>
  object Core::PropertyObserver PropertyObserver
  {
    preset OnEvent = onEvent;
    preset Outlet = ^Application::GlobalSettings.LoginResult;
  }

  // This slot method is executed when the associated property observer 'PropertyObserver' \
  // is notified.
  $rect <1730,270,1930,310>
  slot onEvent
  {
    var int32 result = Application::GlobalSettings.LoginResult;

      if ( result == 1 )
      {
          this.SwitchToDialog( new Application::ProfileScreen, null, null, null, null, null, null, null, null, null, false );
      }
      else if ( result == 2 )
      {
        H2.String = "Invalid PIN";
      }
  }

  // The object 'PropertyObserver' is a handler of property notifications. When the \
  // affected property is notified, the observer calls the associated slot method \
  // 'onEvent' automatically. Within the 'onEvent' method you can react to the notification. \
  // The method 'onEvent' exists for your convenience only. You can remove it and \
  // connect the observer with another slot method. See inline documentation inside \
  // the method.
  // 
  // Don't forget to connect the observer with the property of interest. To do this \
  // set the property 'Outlet' of the observer to refer to the desired property.
  note legend Note
  {
    attr Bounds = <1940,270,2440,470>;
  }
}

$rect <200,180,400,220>
$output false
class ProfileScreen : Core::Group
{
  $rect <1319,70,1519,110>
  inherited method Init()
  {
    SetupLayout();
  }

  $rect <1320,10,1520,50>
  inherited property Bounds = <0,0,1280,720>;

  $rect <20,20,160,60>
  object Application::TitleBar TitleBar
  {
    preset Bounds = <0,0,1280,64>;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,64,1280,615>;
    preset Color = #141A2BFF;
  }

  $rect <20,20,160,60>
  object Views::Line TopLine
  {
    preset Point2 = <1280,64>;
    preset Point1 = <0,64>;
    preset Color = #555D6DFF;
  }

  $rect <20,20,160,60>
  object Views::Line ButtomLine
  {
    preset Point2 = <1280,615>;
    preset Point1 = <0,615>;
    preset Color = #555D6DFF;
  }

  $rect <20,20,160,60>
  object Views::Text H1
  {
    preset Bounds = <48,103,264,139>;
    preset AutoSize = true;
    preset WrapText = false;
    preset String = "Surgical Profiles";
    preset Font = Resources::FontLarge;
  }

  $rect <20,20,160,60>
  object Views::Text H2
  {
    preset Bounds = <48,139,300,157>;
    preset AutoSize = true;
    preset WrapText = false;
    preset String = "Select a profile to begin the operation";
    preset Font = Resources::FontSmall;
  }

  $rect <1350,150,1550,190>
  method void SetupLayout()
  {
    VerticalList.NoOfItems = ProfileH1.size;
  }

  $rect <20,20,160,60>
  object Widget::AddProfileButton AddProfileButton
  {
    preset Bounds = <1048,116,1186,164>;
    preset OnRelease = onAddNewProfile;
  }

  $rect <20,20,160,60>
  object Core::VerticalList VerticalList
  {
    preset Bounds = <42,186,1210,588>;
    preset OnLoadItem = OnLoadItem;
    preset SlideHandler = SlideTouchHandler;
    preset ItemHeight = 120;
    preset NoOfItems = 5;
    preset ItemClass = Widget::ProfileListItem;
  }

  // This method is called by 'VerticalList' every time the list loads or updates \
  // an item.
  $rect <1350,220,1550,260>
  slot OnLoadItem
  {
    var int32 itemNo = VerticalList.Item;
    var Widget::ProfileListItem itemView =
      (Widget::ProfileListItem)VerticalList.View;

    if ( itemView == null )
      return;

    trace "LOAD ITEM = ", itemNo;
    trace "SELECTED ITEM = ", VerticalList.SelectedItem;
    this.SelectedItem = VerticalList.SelectedItem;


    itemView.H1.String = ProfileH1[itemNo];
    itemView.H2.String = ProfileH2[itemNo];

    itemView.OnSelectRadioBT = SlotSelectRadioBT;
    itemView.ItemNo = itemNo;

    if ( itemView.ItemNo == VerticalList.SelectedItem )
    {
      trace "SETTING CLICKED IMAGE = ", itemView.ItemNo;
      itemView.RadioImg.Bitmap = Res::RadioBtClicked;
    }
    else
    {
      itemView.RadioImg.Bitmap = Res::RadioBtNormal;
    }

    itemView.Bounds.size =
      point( VerticalList.Bounds.w, VerticalList.ItemHeight );
  }

  $rect <1350,279,1550,319>
  slot SlotSelectRadioBT
  {
    var Widget::ProfileListItem ListItem =
      (Widget::ProfileListItem)sender;

    trace "SENDER = ", sender;
    trace "LIST ITEM = ", ListItem;

    if ( ListItem == null )
    {
      trace "ERROR LISTITEM NULL";
      return;
    }

    trace "CLICKED ITEM = ", ListItem.ItemNo;

    VerticalList.SelectedItem = ListItem.ItemNo;

    trace "AFTER SET SELECTED = ", VerticalList.SelectedItem;

    VerticalList.InvalidateItems(
      0,
      VerticalList.NoOfItems - 1
    );
  }

  $rect <20,20,160,60>
  object Core::SlideTouchHandler SlideTouchHandler
  {
    preset Bounds = <118,184,1186,588>;
    preset SlideHorz = false;
    preset RetargetDelay = 0;
    preset RetargetCondition = Core::RetargetReason[LongPress];
  }

  $rect <1350,330,1550,370>
  array string ProfileH1[ 4 ] =
  (
    Default[0] = "Laparoscopic - General";
    Default[1] = "Biopsy - Precision";
    Default[2] = "Coagulation - Standard";
    Default[3] = "Temp";
  );

  $rect <1350,370,1550,410>
  array string ProfileH2[ 4 ] =
  (
    Default[0] = "Cut 35W . Coag 28W . Max grasp 6.5N";
    Default[1] = "Cut 18W . Coag 15W . Max grasp 4.0N";
    Default[2] = "Cut 22W . Coag 40W . Max grasp 6.0N";
    Default[3] = "Temp2";
  );

  $rect <20,20,160,60>
  object Application::ProfileButtomBar ProfileButtomBar
  {
    preset Bounds = <0,615,1280,720>;
    preset OnPressSetings = Slot1;
    preset OnPressStart = Slot;
  }

  $rect <1360,470,1560,510>
  slot Slot
  {
    trace "Selected ItemNo = ", SelectedItem;

    if (( SelectedItem >= 0 ) && ( SelectedItem < 3 ))
    {
        Application::GlobalSettings.SelectedProfile = ProfileH1[SelectedItem];
    }

    if ( Owner != null )
    {
      Owner.SwitchToDialog(new Application::ProfileSurgeryInProgressScreen,null, null, null, null, null, null, null, null, null,false);
    }
  }

  $rect <1350,519,1550,559>
  slot Slot1
  {
    if (Owner != null)
    {
        Owner.SwitchToDialog(new Application::SettingsScreen, null, null, null, null, null, null, null, null, null, false);
    }

  }

  $rect <1580,150,1780,190>
  slot onAddNewProfile
  {
    if (Owner != null)
    {
        Owner.SwitchToDialog(new Application::SettingsNewSurgicalProfile, null, null, null, null, null, null, null, null, null, false);
    }
  }

  $rect <1324,650,1524,690>
  var int32 SelectedItem;
}

