  slot Slot1
  {
  }

  $rect <1620,60,1820,100>
  object Effects::Int32Effect moveEffect
  {
    preset OnFinished = SlotMoveEffectFinished;
    preset OnAnimate = SlotMoveEffect;
    preset Timing = Effects::Timing.EaseIn_EaseOut;
    preset NoOfCycles = 1;
    preset CycleDuration = 400;
  }

  $rect <1790,480,1990,520>
  slot SlotMoveEffectFinished
  {
          
  }

  $rect <2010,540,2210,580>
  slot SlotMoveEffect
  {
    this.Outline.ScrollOffset.y = this.moveEffect.Value; 

  }

  $rect <672,834,872,874>
  slot slotKeyboardOpen
  {
    this.Keyboard.Enabled = true;
    this.Keyboard.Visible = true;
    //VirtualKeyboard = this.Keyboard;
    trace "open";
    this.moveEffect.Value1 = this.Outline.ScrollOffset.y;
    if(sender == this.CurrentPassword)
    {
      this.CurrentPassword.TextEditor.Caret.Visible = true;
      this.CurrentPassword.TextEditor.blinkEffect.Enabled = true;
      this.moveEffect.Value2 = 0;
      trace "current";
    }
    else if(sender == this.NewPassword)
    {
      this.NewPassword.TextEditor.Caret.Visible = true;
      this.NewPassword.TextEditor.blinkEffect.Enabled = true;
      this.moveEffect.Value2 = -100;
      postsignal moveEffect.StartEffect;
      trace "new";
    }
    else if(sender == this.ConNewPass)
    {
      this.ConNewPass.TextEditor.Caret.Visible = true;
      this.ConNewPass.TextEditor.blinkEffect.Enabled = true;
      this.moveEffect.Value2 = -250;
      postsignal moveEffect.StartEffect;
      trace "connew";
    }
  }

  $rect <310,800,510,840>
  slot slotKeyboardClose
  {
    this.Keyboard.Enabled = false;
    this.Keyboard.Visible = false;
    //VirtualKeyboard = null;
    this.CurrentPassword.TextEditor.Caret.Visible = false;
    this.CurrentPassword.TextEditor.blinkEffect.Enabled = false;

    this.NewPassword.TextEditor.Caret.Visible = false;
    this.NewPassword.TextEditor.blinkEffect.Enabled = false;

    this.ConNewPass.TextEditor.Caret.Visible = false;
    this.ConNewPass.TextEditor.blinkEffect.Enabled = false;
    trace "Close";
    if(this.moveEffect.Value2 < -90)
    {
        this.moveEffect.Value2 = 0;
        postsignal moveEffect.StartEffect;
    }

  }

  $rect <20,20,160,60>
  object Application::Keyboard Keyboard
  {
    preset Bounds = <2,48,1278,736>;
    preset Focus = null;
    preset Enabled = false;
    preset Visible = false;
    preset KeyBoardOpenStatus;
  }
}

