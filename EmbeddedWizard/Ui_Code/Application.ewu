  $rect <1318,570,1518,610>
  slot SlotOnRelease
  {
    var int32 itemNo = VerticalList.GetItemAtPosition( sthList.CurrentPos );

    trace "ITEMNO================================",itemNo;
    if(itemNo>=0)
    {
        this.SwitchScreen(itemNo);

    }
  }

  $rect <1372,492,1572,532>
  method void SwitchScreen( arg int16 screenNo )
  {
    theme = null;
    switch (screenNo)
    {
        case 0:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsDiagnostic, null, null, null, null, null, null, null, null, null, false);
            }
            trace "screen=1";
        }
        case 1:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsChangePassword, null, null, null, null, null, null, null, null, null, false);
            }
            
        }
        case 2:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsDateTime, null, null, null, null, null, null, null, null, null, false);
            }
            trace "screen=3";
        }
        case 3:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsSystemLogs, null, null, null, null, null, null, null, null, null, false);
            }
            
        }
        default:
        ;
    }
  }
}

