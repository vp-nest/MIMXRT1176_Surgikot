            {
                Owner.SwitchToDialog(new Application::SettingsDisplayTest, null, null, null, null, null, null, null, null, null, false);
            }
            trace "screen=3";
        }
        case 5:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsLEDTest, null, null, null, null, null, null, null, null, null, false);
            }
            trace "screen=3";
        }
        default:
        ;
    } 
  }

