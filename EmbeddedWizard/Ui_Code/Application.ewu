  method void SwitchScreen( arg int16 screenNo )
  {
    theme = null;
    switch (screenNo)
    {
        case 0:
        {
            if (Owner != null)
            {
                Owner.SwitchToDialog(new Application::SettingsMotorTest, null, null, null, null, null, null, null, null, null, false);
            }
            trace "screen=1";
        }
