  $rect <969,500,1169,540>
  var bool Password = false;

  $rect <968,236,1168,276>
  var string RealValue;

  $rect <1211,337,1411,377>
  property bool ShowPassword = false;

  $rect <1211,377,1411,417>
  onset ShowPassword
  {
    // The value doesn't change - nothing to do.
    if ( pure ShowPassword == value )
      return;

    // Remember the property's new value.
    pure ShowPassword = value;
    postsignal updatePasswordDisplay;

    // TO DO:
    // 
    // Now you can handle the alternation of the property.
  }

  $rect <1211,417,1411,457>
  onget ShowPassword
  {
    return pure ShowPassword;
  }

  $rect <1220,280,1420,320>
  slot updatePasswordDisplay
  {
    /******************************************************************************
     * UPDATE PASSWORD DISPLAY
     *
     * Updates the visible text of the TextEditor based on the current
     * password configuration.
     *
     * RealValue:
     *   Contains the actual value entered by the user.
     *
     * Password = false:
     *   Display the actual value.
     *
     * Password = true && ShowPassword = false:
     *   Display '*' for each character.
     *
     * Password = true && ShowPassword = true:
     *   Display the actual password.
     ******************************************************************************/


    // -----------------------------------------------------------------------------
    // DEBUG INFORMATION
    // -----------------------------------------------------------------------------

    // Print the current password state for debugging.
    trace this.RealValue;
    trace this.Password;
    trace this.ShowPassword;


    // -----------------------------------------------------------------------------
    // SHOW ACTUAL VALUE
    // -----------------------------------------------------------------------------

    // Show the actual entered value when:
    //   1. This is not a password field, OR
    //   2. This is a password field and the user enabled ShowPassword.
    //
    // A trailing '\n' is maintained because the TextEditor uses it for
    // correct text/caret layout.
    if ( !Password || ShowPassword )
    {
      Text.String = RealValue + "\n";
    }


    // -----------------------------------------------------------------------------
    // SHOW MASKED PASSWORD
    // -----------------------------------------------------------------------------

    else
    {
      // Build the masked representation of the password.
      // RealValue itself is not modified.
      var string maskedText = "";
      var int32 i;

      // Add one '*' for every character in the actual password.
      for ( i = 0; i < RealValue.length; i = i + 1 )
        maskedText = maskedText + "*";

      // Display the masked password.
      // Keep the trailing newline required by the TextEditor.
      Text.String = maskedText + "\n";
    }
  }

